DATABASE_URL=postgresql+psycopg2://fluxyr:change-me@database:5432/fluxyr
FLUXYR_AGENT_NAME=Default Agent
FLUXYR_PROVIDER=openrouter
FLUXYR_MODEL=minimax/minimax-m3
OPENROUTER_API_KEY=
# Required for this data-only-volume example: persist the same key across deploys.
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
VAULT_ENCRYPTION_KEY=
FLUXYR_EXECUTION_MODE=landlock
