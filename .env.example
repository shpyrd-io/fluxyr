# Required: choose a model and supply the selected provider's key.
FLUXYR_MODEL=minimax/minimax-m3
OPENROUTER_API_KEY=

# Everything below is optional. These are the defaults.
# FLUXYR_PROVIDER=openrouter
# PORT=5050
# FLUXYR_HOST=127.0.0.1
# FLUXYR_AGENT_NAME=Default Agent
# DATABASE_URL defaults to SQLite at .runtime/fluxyr.sqlite3.
# To use PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg2://fluxyr:fluxyr@localhost:5432/fluxyr_agent
# FLUXYR_ROOT=.  # runtime files relative to the process working directory
# FLUXYR_SKILLS_DIR=skills
# FLUXYR_WORKERS=4
# FLUXYR_TOOL_WORKERS=6
# FLUXYR_EXECUTION_MODE=local
# FLUXYR_WORKSPACE_RETENTION_DAYS=30
# FLUXYR_TOOL_TIMEOUT=300
# FLUXYR_MAX_ITERATIONS=40
# FLUXYR_MAX_TOKENS=16000
# Optional: generated and persisted in .runtime/vault.key if absent.
# VAULT_ENCRYPTION_KEY=
# For another provider, set FLUXYR_PROVIDER and its key:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Custom provider also requires endpoint, wire format and CUSTOM_API_KEY:
# FLUXYR_PROVIDER_ENDPOINT=https://example.com/v1
# FLUXYR_PROVIDER_FORMAT=openai
# CUSTOM_API_KEY=
# Full configuration reference: docs/FRAMEWORK.md
