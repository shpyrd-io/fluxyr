DATABASE_URL=postgresql+psycopg2://fluxyr:fluxyr@localhost:5432/fluxyr_agent
FLUXYR_AGENT_NAME=Default Agent
FLUXYR_ROOT=.
FLUXYR_HOST=127.0.0.1
FLUXYR_PORT=5050
# PORT, when set, takes precedence over FLUXYR_PORT.
# PORT=8080
FLUXYR_WORKERS=4
FLUXYR_TOOL_WORKERS=6
FLUXYR_PROVIDER=anthropic

# Empty uses the selected provider's model default.
FLUXYR_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional. Generated and persisted to .runtime/vault.key when omitted.
VAULT_ENCRYPTION_KEY=
# Framework: path relative to FLUXYR_ROOT; empty disables file skills.
FLUXYR_SKILLS_DIR=
FLUXYR_LEASE_SECONDS=90
FLUXYR_TOOL_TIMEOUT=300
# Maximum captured output per bash call (32 MiB); model receives a bounded tail.
FLUXYR_BASH_MAX_OUTPUT_BYTES=33554432
# local works on macOS/Linux. landlock requires Linux with Landlock ABI >= 3.
FLUXYR_EXECUTION_MODE=local
# Purge old temporary workspace entries at worker startup; 0 disables cleanup.
FLUXYR_WORKSPACE_RETENTION_DAYS=30
FLUXYR_MAX_ITERATIONS=40
FLUXYR_HTTP_THREADS=24
FLUXYR_MAX_CONTENT_LENGTH=4194304
# Empty uses the built-in endpoint for anthropic, openai or openrouter.
FLUXYR_PROVIDER_ENDPOINT=
# Required only for FLUXYR_PROVIDER=custom: openai or anthropic.
FLUXYR_PROVIDER_FORMAT=
CUSTOM_API_KEY=
FLUXYR_MAX_TOKENS=16000
FLUXYR_REASONING_EFFORT=
FLUXYR_THINKING_MODE=none
FLUXYR_THINKING_BUDGET=0
FLUXYR_LOG_LEVEL=INFO
